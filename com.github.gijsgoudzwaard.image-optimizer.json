{
    "id": "com.github.gijsgoudzwaard.image-optimizer",
    "base": "io.elementary.BaseApp",
    "base-version": "circe-25.08",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "com.github.gijsgoudzwaard.image-optimizer",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri"
    ],
    "cleanup": [
        "/bin/sassc",
        "/include",
        "/lib/girepository-1.0",
        "/lib/pkgconfig",
        "/man",
        "/share/gir-1.0",
        "/share/man",
        "/share/vala"
    ],
    "modules": [
        {
            "name": "ect",
            "buildsystem": "cmake-ninja",
            "subdir": "src",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DCMAKE_POLICY_VERSION_MINIMUM=3.5"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/fhanau/Efficient-Compression-Tool.git",
                    "tag": "v0.9.5",
                    "commit": "9aabc23d73899ae55c1de292592fed6eb6217f66"
                }
            ]
        },
        {
            "name": "image-optimizer",
            "buildsystem": "meson",
            "config-opts": [
                "--buildtype=release"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/GijsGoudzwaard/Image-Optimizer/archive/refs/tags/0.6.0.tar.gz",
                    "sha256": "6c0ca0160b4c1235ba2b906e3fb295b058d48b3710023f84de5c0808acd18c76"
                },
                {
                    "type": "patch",
                    "path": "elementary-theme.patch"
                }
            ],
            "post-install": [
                "mkdir -p /app/share/icons/hicolor/scalable/apps",
                "mv /app/share/icons/hicolor/128x128/apps/${FLATPAK_ID}.svg /app/share/icons/hicolor/scalable/apps/${FLATPAK_ID}.svg",
                "find /app/share/icons/hicolor -type f -not -path \"*scalable*\" -not -path \"*actions*\" -name \"*.svg\" -delete",
                "rm -f /app/share/icons/hicolor/icon-theme.cache"
            ]
        }
    ]
}
